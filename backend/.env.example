GEMINI_API_KEY=
# optional, defaults to gemini-3.8-flash
GEMINI_MODEL=
# set to true if the key came from Google Cloud console (Vertex express), not AI Studio
GEMINI_VERTEX=false
PORT=8080
# demo-day escape hatch: true turns the SFSU login check off
AUTH_DISABLED=false
ALLOWED_EMAIL_DOMAIN=sfsu.edu
# extra individual accounts allowed besides the domain (comma-separated)
ALLOWED_EMAILS=
# hosting: paste the whole Firebase service account JSON here instead of using serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_JSON=
# hosting: the frontend's address, e.g. https://gatorbite.vercel.app (comma-separated for several)
FRONTEND_ORIGIN=
